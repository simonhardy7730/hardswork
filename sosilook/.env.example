# Clé API Anthropic (Claude) — analyse de la photo.
# Sans clé, le site tourne en "mode démo" avec une analyse d'exemple.
ANTHROPIC_API_KEY=

# Modèle d'analyse (facultatif). Par défaut claude-haiku-4-5, le moins cher.
# Pour comparer la qualité : claude-sonnet-5 ou claude-opus-5.
SOSILOOK_MODEL=

# Clé SerpApi (https://serpapi.com) — recherche Google Shopping (France).
# Sans clé, le site affiche des offres d'exemple clairement marquées.
SERPAPI_KEY=
